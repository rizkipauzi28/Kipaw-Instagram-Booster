# KIPAW IG BOOSTER - Environment Configuration

# 1. Supabase Cloud Configuration (Optional if running in self-contained mode, Required for production cloud DB)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Application Setup
VITE_APP_NAME="KIPAW IG BOOSTER"
VITE_APP_URL="https://kipaw-ig-booster.vercel.app"

# 3. Security & Anti-Abuse Defaults
VITE_MAX_DAILY_TASKS="50"
VITE_TASK_COOLDOWN_SECONDS="30"

# Note: NEVER expose Supabase Service Role Key to frontend or repository.
